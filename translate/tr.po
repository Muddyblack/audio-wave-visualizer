#: package/contents/ui/studio/Schema.js
msgid "Logarithmic"
msgstr "Logaritmik"

#: package/contents/ui/studio/Schema.js
msgid "Mel (resampled)"
msgstr "Mel (yeniden örneklenmiş)"

#: package/contents/ui/studio/Schema.js
msgid "Bass weight"
msgstr "Bas Ağırlığı"

#: package/contents/ui/studio/Schema.js
msgid "Treble weight"
msgstr "Tiz Ağırlığı"

#: package/contents/ui/studio/Schema.js
msgid "Silence release"
msgstr "Sessizlikten Çıkış"

