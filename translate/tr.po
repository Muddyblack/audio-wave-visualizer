msgstr "Çam Gölü"

msgid "Afterglow"
msgstr "Alacakaranlık Işıltısı"

msgid "Midnight marina"
msgstr "Gece Yarısı Marinası"

msgid "Aurora sound"
msgstr "Kutup Işıkları Sesi"

msgid "Moss & mist"
msgstr "Yosun ve Sis"

msgid "Silver tide"
msgstr "Gümüş Gelgit"

